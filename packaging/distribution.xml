<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer layout for Duette. scripts/build-pkg.sh replaces @VERSION@ and
  @COMPONENT@ and runs productbuild on the result.

  There is one component package. Its payload holds the app, the driver and
  the support scripts, so the postinstall always runs after all of them are
  in place.
-->
<installer-gui-script minSpecVersion="2">
  <title>Duette</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>

  <!-- Apple Silicon, installed on the startup disk, no choices to make. -->
  <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="14.2"/>
    </allowed-os-versions>
  </volume-check>

  <choices-outline>
    <line choice="me.roboroads.duette.pkg"/>
  </choices-outline>
  <choice id="me.roboroads.duette.pkg" visible="false" title="Duette">
    <pkg-ref id="me.roboroads.duette.pkg"/>
  </choice>
  <pkg-ref id="me.roboroads.duette.pkg" version="@VERSION@" auth="root">@COMPONENT@</pkg-ref>
</installer-gui-script>
